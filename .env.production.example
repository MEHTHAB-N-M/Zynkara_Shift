# =============================================================================
# ZynkaraShift — Production Environment Template (Root)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.production.example .env
# =============================================================================

# ── PostgreSQL Control Plane Database ────────────────────────────────────────
POSTGRES_DB=VaporupDeploy
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Platform Domain ─────────────────────────────────────────────────────────
# Your domain pointed to this server. Used for Traefik routing.
# If using Cloudflare Tunnel: your tunnel's public hostname
# If using Azure Public IP + DuckDNS: your DuckDNS subdomain
PLATFORM_DOMAIN=zynkarashift.duckdns.org

# ── Cloudflare Tunnel (Optional — leave empty to use direct Azure Public IP) ─
# Get this from: Cloudflare Zero Trust → Networks → Tunnels → Create Tunnel
TUNNEL_TOKEN=

# ── Azure-specific (filled by provision script) ─────────────────────────────
# VM_PUBLIC_IP=  (auto-detected at runtime)
