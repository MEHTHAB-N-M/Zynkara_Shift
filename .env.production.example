# =============================================================================
# ZynkaraShift — Production Environment Template (Root)
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.production.example .env
# =============================================================================

# ── PostgreSQL Control Plane Database ────────────────────────────────────────
POSTGRES_DB=your_db_name
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ── Platform Domain ─────────────────────────────────────────────────────────
# Your domain pointed to this server (e.g. your DuckDNS subdomain or custom domain). Used for Traefik routing.
PLATFORM_DOMAIN=your-domain.duckdns.org

# ── Azure-specific (filled by provision script) ─────────────────────────────
# VM_PUBLIC_IP=  (auto-detected at runtime)
