# =============================================================================
# ZynkaraShift — Backend Production Environment Template
# =============================================================================
# Copy this file to backend/.env and fill in your values:
#   cp backend/.env.production.example backend/.env
# =============================================================================

# ── JWT Token Signing ───────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random secret for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_64_BYTE_HEX

# ── Google OAuth (Optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth App ────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → New OAuth App
# Set callback URL to: https://YOUR_DOMAIN/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Auth Settings ───────────────────────────────────────────────────────────
BYPASS_MOCK_AUTH=true

# ── Database (auto-configured by Docker Compose) ────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=VaporupDeploy
DATABASE_URL=postgresql://postgres:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres-control:5432/VaporupDeploy

# ── Seed Accounts ──────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@sovereign.local
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

SEED_PREMIUM_EMAIL=premium@sovereign.local
SEED_PREMIUM_PASSWORD=CHANGE_ME_PREMIUM_PASSWORD

SEED_FREE_EMAIL=free@sovereign.local
SEED_FREE_PASSWORD=CHANGE_ME_FREE_PASSWORD

# ── Stripe Payments (Optional — leave empty to disable) ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
